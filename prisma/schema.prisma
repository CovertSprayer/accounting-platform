// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id   String @id
  name String

  accounts       Account[]
  journalEntries JournalEntry[]
  customers      Customer[]
  vendors        Vendor[]
  invoices       Invoice[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Account {
  id        String
  companyId String
  name      String
  type      AccountType

  company            Company            @relation(fields: [companyId], references: [id])
  journalLines       JournalEntryLine[]
  invoiceLines       InvoiceLine[]
  receivableInvoices Invoice[]          @relation("InvoiceReceivableAccount")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([companyId, id])
  @@index([companyId])
}

model Customer {
  id        String
  companyId String
  name      String
  email     String?
  phone     String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoices Invoice[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([companyId, id])
  @@unique([companyId, email])
}

model Vendor {
  id        String
  companyId String
  name      String
  email     String?
  phone     String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([companyId, id])
  @@unique([companyId, email])
}

model JournalEntry {
  id        String             @id
  companyId String
  date      DateTime           @db.Date
  status    JournalEntryStatus

  company Company            @relation(fields: [companyId], references: [id])
  lines   JournalEntryLine[]
  invoice Invoice?           @relation("InvoiceJournalEntry")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Lets other tables reference a journal entry together with its company,
  // so the database rejects cross-company links (see Invoice.journalEntry).
  @@unique([companyId, id])
  @@index([companyId])
}

model Invoice {
  id                  String
  companyId           String
  customerId          String
  number              String
  issueDate           DateTime      @db.Date
  dueDate             DateTime      @db.Date
  status              InvoiceStatus
  journalEntryId      String?
  receivableAccountId String?

  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer          Customer      @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  receivableAccount Account?      @relation("InvoiceReceivableAccount", fields: [companyId, receivableAccountId], references: [companyId, id], onDelete: Restrict)
  journalEntry      JournalEntry? @relation("InvoiceJournalEntry", fields: [companyId, journalEntryId], references: [companyId, id], onDelete: Restrict)
  lines             InvoiceLine[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@id([companyId, id])
  @@unique([companyId, number])
  @@unique([companyId, journalEntryId])
  @@index([companyId, customerId])
}

model InvoiceLine {
  id          String  @id
  companyId   String
  invoiceId   String
  accountId   String
  position    Int
  description String
  quantity    Decimal @db.Decimal(20, 4)
  unitPrice   Decimal @db.Decimal(20, 4)

  invoice Invoice @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  account Account @relation(fields: [companyId, accountId], references: [companyId, id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([companyId, invoiceId, position])
  @@index([companyId, accountId])
}

model JournalEntryLine {
  id             String @id
  journalEntryId String
  companyId      String
  accountId      String

  debit  Decimal @db.Decimal(20, 4)
  credit Decimal @db.Decimal(20, 4)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id])
  account      Account      @relation(fields: [companyId, accountId], references: [companyId, id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([journalEntryId])
  @@index([companyId, accountId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
}
